# Environment Variables Template
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!

# =============================================================================
# APPLICATION INSIGHTS (Optional)
# =============================================================================
# Get these from Azure Portal > Application Insights > Properties
# Client-side telemetry (exposed to browser - use NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key-here;IngestionEndpoint=https://your-region.in.applicationinsights.azure.com/

# Server-side telemetry (never exposed to browser)
APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key-here;IngestionEndpoint=https://your-region.in.applicationinsights.azure.com/

# =============================================================================
# NODE.JS SERVER CONFIGURATION
# =============================================================================
# Environment: development, production, test
NODE_ENV=production

# Server hostname (defaults to localhost)
HOSTNAME=localhost

# Server port (defaults to 3000)
PORT=3000

# =============================================================================
# SECURITY CONFIGURATION (Production)
# =============================================================================
# Encryption key for file storage (generate with: openssl rand -base64 32)
# ENCRYPTION_KEY=your-32-byte-encryption-key-here

# JWT secret for authentication (if implementing auth)
# JWT_SECRET=your-jwt-secret-here

# Session secret (if using sessions)
# SESSION_SECRET=your-session-secret-here

# =============================================================================
# DATABASE CONFIGURATION (Production)
# =============================================================================
# Replace in-memory storage with database
# DATABASE_URL=postgresql://user:password@localhost:5432/excelrenderer
# DATABASE_URL=mongodb://user:password@localhost:27017/excelrenderer

# =============================================================================
# FILE STORAGE CONFIGURATION (Production)
# =============================================================================
# Azure Blob Storage
# AZURE_STORAGE_CONNECTION_STRING=your-connection-string
# AZURE_STORAGE_CONTAINER_NAME=excel-files

# AWS S3
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1

# =============================================================================
# RATE LIMITING (Production)
# =============================================================================
# Requests per minute per IP
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# CORS CONFIGURATION (Production)
# =============================================================================
# Comma-separated list of allowed origins
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
# Log level: error, warn, info, debug
# LOG_LEVEL=info

# Sentry DSN for error tracking
# SENTRY_DSN=your-sentry-dsn

# =============================================================================
# PRODUCTION URLS
# =============================================================================
# Public URL of the application
# NEXT_PUBLIC_APP_URL=https://yourdomain.com

# API base URL
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features
# ENABLE_FILE_API=true
# ENABLE_TELEMETRY=true
# ENABLE_AUTHENTICATION=false

# =============================================================================
# NOTES
# =============================================================================
# 1. Never commit .env.local or .env.production to version control
# 2. Use strong, randomly generated secrets (32+ characters)
# 3. Rotate secrets regularly (every 90 days recommended)
# 4. Use different values for development and production
# 5. Store production secrets in secure vault (Azure Key Vault, AWS Secrets Manager)
# 6. Use environment-specific prefixes: DEV_, PROD_, TEST_
